# OCCV2 Dapp — environment configuration
#
# Copy to `.env.local` for local development. Every NEXT_PUBLIC_* value is
# inlined into the browser bundle — NEVER put secrets or private keys here.

# ── Ethereum mainnet RPC ────────────────────────────────────────────────
# Optional. If unset, the dapp uses a built-in list of public endpoints
# (PublicNode, LlamaRPC, Ankr, Cloudflare). Public RPC has no dependable
# websocket and rate-limits log queries, so real-time refresh runs on a
# ~12s poll. To upgrade to instant push, set a private provider URL here —
# no code change required.
#
# HTTP endpoint (used for all reads, writes, and gas estimation):
NEXT_PUBLIC_RPC_URL=

# Websocket endpoint (optional; enables push-based event delivery):
NEXT_PUBLIC_RPC_WS_URL=

# ── Public Free Mint permit signer (server-side) ────────────────────────
# The dapp's own Next.js API route (`/api/free-mint/permit`) signs EIP-712
# permits in production. There is no external backend — the contract's
# per-wallet cap, holder check, and total cap are the actual anti-abuse
# guards. Set these in Vercel as ENCRYPTED env vars (NOT prefixed with
# NEXT_PUBLIC_, so they stay server-only).

# Required for the mint flow to work on the live route.
# Private key of the address configured as `trustedSigner` on the
# OCCV2PublicFreeMint contract.
OCCV2_PERMIT_SIGNER_PRIVATE_KEY=

# Optional. Lifetime of a signed permit in seconds before the contract
# refuses it. Defaults to 1800 (30 minutes) when unset.
OCCV2_PERMIT_DEADLINE_SECONDS=

# Optional. Restrict permit requests to a single wallet — useful for a
# locked-down preview/staging deployment. Leave unset in production.
OCCV2_PERMIT_ALLOW_WALLET=

# Optional. Override the permit fetch URL if you ever move the signer to a
# separate service. Defaults to the dapp's own /api/free-mint/permit route.
NEXT_PUBLIC_PERMIT_URL=

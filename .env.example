# OCCV2 Dapp — environment configuration
#
# Copy to `.env.local` for local development. Every NEXT_PUBLIC_* value is
# inlined into the browser bundle — NEVER put secrets or private keys here.

# ── Ethereum mainnet RPC ────────────────────────────────────────────────
# Optional. If unset, the dapp uses a built-in list of public endpoints
# (PublicNode, LlamaRPC, Ankr, Cloudflare). Public RPC has no dependable
# websocket and rate-limits log queries, so real-time refresh runs on a
# ~12s poll. To upgrade to instant push, set a private provider URL here —
# no code change required.
#
# HTTP endpoint (used for all reads, writes, and gas estimation):
NEXT_PUBLIC_RPC_URL=

# Websocket endpoint (optional; enables push-based event delivery):
NEXT_PUBLIC_RPC_WS_URL=
